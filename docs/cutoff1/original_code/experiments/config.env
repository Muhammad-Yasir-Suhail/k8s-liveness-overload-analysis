# Experiment configuration — Group G18
#
# SATURATION_RATE is the single most important number in this project.
# It comes from calibrate.sh. Do NOT guess it. Every load level in the
# sweep is defined relative to it, and the paper reports it as a measured
# quantity — that is what makes single-laptop testing defensible.

SATURATION_RATE=40     # req/s for ONE replica. REPLACE after calibration.

REPEATS=5              # repetitions per configuration
RUN_DURATION="10m"     # per-run load duration
