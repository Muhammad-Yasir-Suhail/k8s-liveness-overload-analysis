# =====================================================================
#  Experiment configuration -- Group G18, Deliverable 02
#  Every script sources this file. Change values HERE, not in scripts.
# =====================================================================

# ---- how much to run -------------------------------------------------
#   smoke : ~40 min, short runs of a few cells -- ONLY to check the setup
#   quick : ~5 h,    enough for the Deliverable 02 report  (DEFAULT)
#   full  : ~10-11 h, run overnight for the final paper (Cutoff 3)
PROFILE="${PROFILE:-quick}"

# ---- cluster ---------------------------------------------------------
CLUSTER_NAME="g18"
CLUSTER_CONFIG="${CLUSTER_CONFIG:-cluster/kind-single.yaml}"
TOOLS_IMAGE="g18/tools:latest"
CATALOGUE_IMAGE="weaveworksdemos/catalogue:0.3.5"
CATALOGUE_DB_IMAGE="weaveworksdemos/catalogue-db:0.3.0"

# ---- Experiment R: reproduction of Roberts et al. -------------------
R_ARMS="DP FP SKI"
R_DURATION_S=290          # paper: figures cover 290 s
R_INJECT_AT_S=60          # paper: failure 60 s after the load starts
R_USERS=100               # 100 users x 1 req/s  = 100 req/s cap (paper)
R_PACE_MS=1000
R_TIMEOUT_MS=500          # paper: 0.5 s request timeout
R_WARMUP_DP_S=330         # DP liveness has initialDelaySeconds=300
R_WARMUP_FAST_S=120      # FP and SKI: let any start-up restart loop settle

# ---- Service under test (Experiments C, O, H, D) ----------------------
REPLICAS=6                # fixed, HPA disabled
WORKERS=4                 # size of the shared worker pool
WORK_UNITS=100000         # CPU work per request (~10-15 ms on a free core)
CPU="200m"                # container CPU limit (makes the quota bind)
WINDOW_MS=5000            # Component A stall window W
LOAD_DURATION_S=240
SETTLE_S=20               # quiet time after rollout before load
INJECT_AT_S=60            # fault injection time in H and D
CLIENT_TIMEOUT_MS=2000

# ---- Component B (governor) defaults ---------------------------------
GOV_THRESHOLD=1
GOV_CORR_FRAC=0.5
GOV_BUDGET_FRAC=0.25
GOV_HOLD_S=60

# ---- Experiment C: calibration ----------------------------------------
C_RATES="5 10 15 20 25 30 35 40 50 60"
C_STEP_S=45

# ---- Experiments O / P / H / D -------------------------------------------
# O: sustained load, no fault. Loads in % of the MEASURED cluster capacity.
#    (Cutoff 1 planned 50/100/150 %. With an open model, FIFO queue and 2 s
#    client timeout, EVERY arm collapses above ~110 %, so the informative
#    range is just below saturation. The simulator covers 50-150 %.)
O_LOADS="90"
O_ARMS="NONE DP FP ISO A B AB"
# P: a 60 s load spike from 70 % to 150 %, then back to 70 %.
P_LOAD=70
P_PEAK_PCT=150
P_LEN_S=60
P_ARMS="NONE DP FP ISO A B AB"
H_LOAD=70
H_ARMS="NONE FP ISO A B AB"
D_LOAD=70
D_STALL_S=20
D_ARMS="NONE FP ISO A B AB"

# where results go (smoke runs go to a separate folder so they never mix)
RESULTS_DIR="${RESULTS_DIR:-results/testbed}"

case "$PROFILE" in
  smoke) R_REPEATS=1; O_REPEATS=1; P_REPEATS=1; H_REPEATS=1; D_REPEATS=1
         R_ARMS="FP"; R_DURATION_S=150; C_STEP_S=30; LOAD_DURATION_S=150
         O_ARMS="FP A"; P_ARMS="FP"; H_ARMS="A"; D_ARMS="A"
         RESULTS_DIR="results/testbed-smoke" ;;
  quick) R_REPEATS=3; O_REPEATS=1; P_REPEATS=1; H_REPEATS=2; D_REPEATS=2 ;;
  full)  R_REPEATS=5; O_REPEATS=2; P_REPEATS=2; H_REPEATS=3; D_REPEATS=3
         O_LOADS="60 90 120" ;;
  *) echo "unknown PROFILE=$PROFILE"; exit 1 ;;
esac
